{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flame Shrine Finder",
  "version": "0.1.0",
  "identifier": "io.github.quantumsheep.flame-shrine-finder",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flame Shrine Finder",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE"
  }
}
